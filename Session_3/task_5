import 'package:flutter/material.dart';

void main() {
  runApp(
    MaterialApp(
      debugShowCheckedModeBanner: false,
      home: MyHomePage(),
    ),
  );
}

class MyHomePage extends StatefulWidget {
  @override
  State<MyHomePage> createState() => _MyHomePageState();
}

class _MyHomePageState extends State<MyHomePage> {
  // Time values store karne ke liye List
  List<String> tapTimes = [];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text("Tap Time"),
      ),

      body: Center(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [

            // Button
            ElevatedButton(
              onPressed: () {
                setState(() {
                  String currentTime =
                      TimeOfDay.now().format(context);

                  tapTimes.add(currentTime);
                });
              },
              child: Text("Add Current Time"),
            ),

            // List ko Text widgets me convert karna
            ...tapTimes.map(
              (time) => Text("Tapped at: $time"),
            ),
          ],
        ),
      ),
    );
  }
}
